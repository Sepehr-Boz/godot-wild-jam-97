layout_mode = 2
bbcode_enabled = true
text = "[font=res://fonts/Bungee/Bungee-Regular.ttf][font_size=44]This is the [u][rainbow freq=1.0 sat=0.8 val=0.8 speed=0.2]Rogue.[/rainbow][/u][/font_size]
[font_size=24]He is able to move in [color=11ee11ff]4 straight directions, 2 spaces at a time.[/color]
[ul]The [color=11ee11ff]objective[/color] is to kill all the enemies by moving onto them within the least number of actions as possible.
To [color=11ee11ff]move[/color] the character drag from the character to the destination spot to mark where it will move to. To cancel a move simply click on the character and it will stay stationary for the next time.
Use the scroll wheel to [color=11ee11ff]increment and decrement the time[/color] in the level, and confirm your path once the objective has been reached[/ul][/font_size][/font]
"

